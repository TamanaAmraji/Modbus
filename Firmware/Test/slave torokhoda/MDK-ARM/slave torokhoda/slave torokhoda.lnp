--cpu Cortex-M3
"slave torokhoda\startup_stm32f103xb.o"
"slave torokhoda\main.o"
"slave torokhoda\gpio.o"
"slave torokhoda\usart.o"
"slave torokhoda\stm32f1xx_it.o"
"slave torokhoda\stm32f1xx_hal_msp.o"
"slave torokhoda\s_modbus.o"
"slave torokhoda\modbus_crc.o"
"slave torokhoda\stm32f1xx_hal_gpio_ex.o"
"slave torokhoda\stm32f1xx_hal_tim.o"
"slave torokhoda\stm32f1xx_hal_tim_ex.o"
"slave torokhoda\stm32f1xx_hal_uart.o"
"slave torokhoda\stm32f1xx_hal.o"
"slave torokhoda\stm32f1xx_hal_rcc.o"
"slave torokhoda\stm32f1xx_hal_rcc_ex.o"
"slave torokhoda\stm32f1xx_hal_gpio.o"
"slave torokhoda\stm32f1xx_hal_dma.o"
"slave torokhoda\stm32f1xx_hal_cortex.o"
"slave torokhoda\stm32f1xx_hal_pwr.o"
"slave torokhoda\stm32f1xx_hal_flash.o"
"slave torokhoda\stm32f1xx_hal_flash_ex.o"
"slave torokhoda\stm32f1xx_hal_exti.o"
"slave torokhoda\system_stm32f1xx.o"
--strict --scatter "slave torokhoda\slave torokhoda.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "slave torokhoda.map" -o "slave torokhoda\slave torokhoda.axf"